# Copiar a .env y ajustar.  cp .env.example .env

# Puerto en el host (la app adentro del contenedor siempre escucha en 8090).
# Se publica solo en 127.0.0.1, no queda expuesto a internet.
PUERTO_HOST=8090

# Dominio para el perfil "https" (Caddy saca el certificado solo).
# Con sslip.io no hace falta comprar nada: equipos-<tu-ip-con-guiones>.sslip.io
DOMINIO=equipos-1-2-3-4.sslip.io

# Usuario inicial (solo se usa la primera vez, cuando la base está vacía)
ADMIN_USER=admin
ADMIN_PASS=cambiar-esto-ya

# Nombre del club: encabeza el texto que se manda por WhatsApp
CLUB_NOMBRE=Barceló Rugby

# Duración de la sesión en el celular (días)
SESSION_DAYS=90

# true si vas a servir por HTTPS (recomendado). Poné false solo si probás por http://ip:puerto
SECURE_COOKIE=true

# --- Solo para la instalación sin Docker (systemd) ---
# PORT=8090
# HOST=127.0.0.1
# DB_PATH=/opt/rugby-equipos/data/rugby.db
